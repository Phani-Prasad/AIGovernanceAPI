# ─────────────────────────────────────────────────────────────
# AI Governance & Security Layer API — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── App Settings ──────────────────────────────────────────────
APP_NAME="AI Governance API"
APP_VERSION="1.0.0"
APP_ENV=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── API Security ──────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440       # 24 hours
API_KEY_PREFIX=gvn_           # Governance API key prefix

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_governance
# For local development with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./ai_governance.db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider Keys (stored here for local dev only) ────────
# In production, use HashiCorp Vault or AWS Secrets Manager
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
AZURE_API_KEY=...
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview
COHERE_API_KEY=...

# ── Security Pipeline ─────────────────────────────────────────
PII_DETECTION_ENABLED=true
PII_ACTION=mask               # detect | mask | block
INJECTION_DETECTION_ENABLED=true
INJECTION_SENSITIVITY=medium  # low | medium | high | strict
CONTENT_MODERATION_ENABLED=true

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_DAY=1000000

# ── Audit & Compliance ────────────────────────────────────────
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
LOG_REQUEST_BODY=true         # Set false for max privacy
LOG_RESPONSE_BODY=false       # Set false for max privacy

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123!

# ── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Model Evaluation ──────────────────────────────────────────
# Global defaults — per-org overrides via PATCH /v1/orgs/me/settings/evaluation
EVAL_ENABLED=false                           # Master switch (false = no eval for any org)
EVAL_MODE=async                              # inline | async | disabled

# Hallucination detection (method: llm_judge | self_consistency | grounding)
EVAL_HALLUCINATION_ENABLED=true
EVAL_HALLUCINATION_METHOD=llm_judge
EVAL_HALLUCINATION_JUDGE_MODEL=gpt-4o-mini  # Model used as judge (must be in your provider config)
EVAL_HALLUCINATION_THRESHOLD=0.75           # Score >= this = flagged
EVAL_HALLUCINATION_ON_FLAG=warn             # warn | block | log_only

# Bias / toxicity detection (method: toxicity | llm_judge | both)
EVAL_BIAS_ENABLED=true
EVAL_BIAS_METHOD=toxicity                   # 'toxicity' uses local detoxify (no API key)
EVAL_BIAS_THRESHOLD=0.60
EVAL_BIAS_ON_FLAG=warn                      # warn | block | log_only
